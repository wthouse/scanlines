{{- /* RSS override.

     Hugo's embedded template feeds every RegularPage and emits raw .Summary
     HTML. For this theme that meant three problems in the shipped feed:
       * utility pages with no date (About, Archive) shipped
         <pubDate>Mon, 01 Jan 0001 …</pubDate> — not a valid RFC-822 date
       * auto-summaries carried heading-permalink anchors (render-heading.html)
         and full Chroma line-number tables into item descriptions
       * the home feed advertised pages nobody subscribes to a blog for

     So: the home feed carries the configured contentSection only, every feed
     skips zero-date pages, and descriptions are plain text. */ -}}
{{- $section := site.Params.scanlines.contentSection | default "posts" -}}
{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- $pages = where site.RegularPages "Section" $section -}}
{{- end -}}
{{- $pages = where $pages "Date.IsZero" false -}}
{{- $limit := site.Config.Services.RSS.Limit -}}
{{- if ge $limit 1 -}}
  {{- $pages = $pages | first $limit -}}
{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ site.Title }}{{ else }}{{ printf "%s | %s" .Title site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ if .IsHome }}{{ site.Params.description }}{{ else }}{{ .Description | default .Title }}{{ end }}</description>
    <generator>Hugo</generator>{{ with site.Language.LanguageCode }}
    <language>{{ . }}</language>{{ end }}{{ with site.Params.author }}
    <managingEditor>{{ . }}</managingEditor>
    <webMaster>{{ . }}</webMaster>{{ end }}{{ with .Date }}
    <lastBuildDate>{{ .Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{- with .OutputFormats.Get "RSS" }}
    {{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType.Type | safeHTML }}
    {{- end }}
    {{- range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{- with .Params.author | default site.Params.author }}
      <author>{{ . }}</author>
      {{- end }}
      <guid>{{ .Permalink }}</guid>
      {{- /* Plain text: keeps heading anchors and highlighted code out of readers. */}}
      <description>{{ .Description | default (.Summary | plainify) | chomp }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
